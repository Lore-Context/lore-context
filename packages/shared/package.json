{
  "name": "@lore/shared",
  "version": "0.6.0-alpha.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./secrets/*": {
      "types": "./dist/secrets/*.d.ts",
      "default": "./dist/secrets/*.js"
    },
    "./crypto/*": {
      "types": "./dist/crypto/*.d.ts",
      "default": "./dist/crypto/*.js"
    },
    "./import/*": {
      "types": "./dist/import/*.d.ts",
      "default": "./dist/import/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "argon2": "^0.44.0",
    "secure-remote-password": "^0.3.1"
  }
}
